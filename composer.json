{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "xsaveopt/auction-website",
    "type": "project",
    "description": "Auction website with live bidding, leftover sales and admin tooling.",
    "license": "GPL-2.0-only",
    "require": {
        "php": "~8.5.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/octane": "^2.14",
        "laravel/socialite": "^5.24",
        "minishlink/web-push": "^11.0",
        "promphp/prometheus_client_php": "^2.0",
        "socialiteproviders/microsoft": "^4.8"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "carthage-software/mago": "^1.13",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-mockery": "^2.0.0",
        "phpstan/phpstan-phpunit": "^2.0.19",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan octane:start --watch"
        ],
        "format": [
            "@php vendor/bin/mago format"
        ],
        "format:check": [
            "@php vendor/bin/mago format --check"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
        ],
        "test": [
            "@php vendor/bin/paratest --runner=WrapperRunner"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
