{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.14.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "oxlint resources/js/",
        "format": "oxfmt resources/js/",
        "format:check": "oxfmt --check resources/js/",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.4.1",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "vue": "^3.5.42",
        "vue-router": "^5.3.0"
    }
}
