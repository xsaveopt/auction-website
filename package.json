{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit && vue-tsc --noEmit",
        "lint": "oxlint resources/js/",
        "format": "oxfmt resources/js/",
        "format:check": "oxfmt --check resources/js/",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.2.1",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "vue": "^3.5.45",
        "vue-router": "^5.5.0"
    }
}
